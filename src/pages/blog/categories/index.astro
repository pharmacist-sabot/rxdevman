---
import { getCollection } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import { slugify } from '@/utils/slugify';

const allPosts = await getCollection('blog');

type CategoryInfo = { name: string; count: number };
const categoryMap = new Map<string, number>();

for (const post of allPosts) {
  categoryMap.set(post.data.category, (categoryMap.get(post.data.category) ?? 0) + 1);
}

const categories: CategoryInfo[] = Array.from(categoryMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="Categories">
  <div class="container">

    <div class="page-header">
      <p class="filter-label">Browse</p>
      <h1>Categories</h1>
      <p class="filter-subtitle">
        {categories.length} categories across {allPosts.length} articles.
      </p>
    </div>

    <div class="category-grid">
      {categories.map(category => (
        <a href={`/blog/categories/${slugify(category.name)}`} class="category-card">
          <h2 class="category-name">{category.name}</h2>
          <span class="category-count">
            {category.count} article{category.count !== 1 ? 's' : ''}
          </span>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-12);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .page-header h1 { margin-bottom: var(--space-2); }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto;
  }

  .category-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-decoration: none;
    transition: box-shadow var(--duration-200) var(--ease),
      border-color var(--duration-200) var(--ease),
      transform var(--duration-200) var(--ease);
  }

  .category-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--brand-btn-border);
    transform: translateY(-2px);
  }

  .category-name {
    font-size: var(--text-base);
    color: var(--text-heading);
    margin-bottom: var(--space-2);
  }

  .category-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
